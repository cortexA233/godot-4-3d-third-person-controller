+		return GRENADE_THROW_PROFILE.aimed_launch_velocity(origin, aim_target, forward)
+	return GRENADE_THROW_PROFILE.default_launch_velocity(forward)
+
+
+func _get_grenade_forward(is_aiming: bool) -> Vector3:
+	if is_aiming:
+		var aim_target: Vector3
+		aim_target = _camera_controller.get_aim_target()
+		var aim_direction: Vector3 = aim_target - global_position
+		aim_direction.y = 0.0
+		if aim_direction.length() > 0.001:
+			return aim_direction.normalized()
+
+	var character_forward := _rotation_root.global_transform.basis * Vector3.BACK
+	character_forward.y = 0.0
+	if character_forward.length() > 0.001:
+		return character_forward.normalized()
+	return _last_strong_direction.normalized()
+
+
+func _predict_grenade_points(origin: Vector3, launch_velocity: Vector3) -> PackedVector3Array:
+	var points := PackedVector3Array()
+	var previous_point := origin
+	points.append(origin)
+
+	var space_state := get_world_3d().direct_space_state
+	for index in range(1, grenade_preview_steps):
+		var time: float = float(index) * grenade_preview_step_time
+		var next_point := origin + launch_velocity * time + Vector3.DOWN * (0.5 * GRENADE_THROW_PROFILE.GRAVITY * time * time)
+		var query := PhysicsRayQueryParameters3D.create(previous_point, next_point)
+		query.exclude = [get_rid()]
+		query.collision_mask = 3
+		var hit := space_state.intersect_ray(query)
+		if hit:
+			points.append(hit.position)
+			return points
+		points.append(next_point)
+		previous_point = next_point
+	return points
+
