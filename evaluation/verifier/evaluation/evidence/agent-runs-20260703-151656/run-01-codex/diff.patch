+class_name GrenadeTrajectoryPreview
+extends Node3D
+
+@export var ready_color := Color(0.0, 0.78, 1.0, 0.95)
+@export var cooldown_color := Color(0.2, 0.55, 0.65, 0.45)
+
+@onready var _trajectory_line: MeshInstance3D = $TrajectoryLine
+@onready var _trajectory_dots: MultiMeshInstance3D = $TrajectoryDots
+@onready var _landing_marker: MeshInstance3D = $LandingMarker
+
+var _line_mesh := ImmediateMesh.new()
+var _line_material := StandardMaterial3D.new()
+var _dot_material := StandardMaterial3D.new()
+var _marker_material: Material
+
+
+func _ready() -> void:
+	top_level = true
+	global_transform = Transform3D.IDENTITY
+	_trajectory_line.mesh = _line_mesh
+	_setup_unshaded_material(_line_material)
+	_setup_unshaded_material(_dot_material)
+	_trajectory_line.material_override = _line_material
+	_trajectory_dots.material_override = _dot_material
+	_marker_material = _landing_marker.get_surface_override_material(0).duplicate()
+	_landing_marker.set_surface_override_material(0, _marker_material)
+	hide_preview()
+
+
+func show_preview(points: PackedVector3Array, is_ready: bool) -> void:
+	if points.size() < 2:
+		hide_preview()
+		return
+
+	visible = true
+	var color := ready_color if is_ready else cooldown_color
+	_update_material_color(_line_material, color)
+	_update_material_color(_dot_material, color)
+	if _marker_material is ShaderMaterial:
+		(_marker_material as ShaderMaterial).set_shader_parameter("fill_color", color)
+
+	_line_mesh.clear_surfaces()
+	_line_mesh.surface_begin(Mesh.PRIMITIVE_LINE_STRIP, _line_material)
+	for point in points:
+		_line_mesh.surface_add_vertex(point)
+	_line_mesh.surface_end()
+
+	var dot_count: int = points.size()
+	if dot_count > 18:
+		dot_count = 18
+	_trajectory_dots.multimesh.instance_count = dot_count
+	for index in range(dot_count):
+		var point_ratio: float = 0.0
+		if dot_count > 1:
+			point_ratio = float(index) / float(dot_count - 1)
+		var point_index: int = int(round(point_ratio * float(points.size() - 1)))
+		_trajectory_dots.multimesh.set_instance_transform(index, Transform3D(Basis(), points[point_index]))
+
+	_landing_marker.global_position = points[points.size() - 1] + Vector3.UP * 0.035
+	_landing_marker.visible = true
+
+
+func hide_preview() -> void:
+	visible = false
+	_line_mesh.clear_surfaces()
+	if is_instance_valid(_trajectory_dots.multimesh):
+		_trajectory_dots.multimesh.instance_count = 0
+
+
+func _setup_unshaded_material(material: StandardMaterial3D) -> void:
+	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
+	material.no_depth_test = true
+
+
+func _update_material_color(material: StandardMaterial3D, color: Color) -> void:
+	material.albedo_color = color
+	material.emission_enabled = true
+	material.emission = Color(color.r, color.g, color.b)
+	material.emission_energy_multiplier = 1.6
