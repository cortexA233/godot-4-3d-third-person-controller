+class_name GrenadeProjectile
+extends RigidBody3D
+
+const EXPLOSION_SCENE := preload("res://player/explosion_visuals/explosion_scene.tscn")
+
+@export var fuse_time := 1.35
+@export var impact_fuse_time := 0.25
+@export var explosion_radius := 3.5
+@export var explosion_force := 12.0
+
+var thrower: Node3D = null
+
+var _has_detonated := false
+var _has_impacted := false
+var _fuse_timer: SceneTreeTimer
+
+
+func setup(initial_velocity: Vector3, source: Node3D) -> void:
+	thrower = source
+	linear_velocity = initial_velocity
+	angular_velocity = Vector3(initial_velocity.z, 0.0, -initial_velocity.x).limit_length(16.0)
+	if thrower is PhysicsBody3D:
+		add_collision_exception_with(thrower)
+
+
+func _ready() -> void:
+	body_entered.connect(_on_body_entered)
+	_fuse_timer = get_tree().create_timer(fuse_time)
+	_fuse_timer.timeout.connect(_detonate)
+
+
+func _on_body_entered(body: Node) -> void:
+	if _has_detonated or body == thrower or _has_impacted:
+		return
+	_has_impacted = true
+	get_tree().create_timer(impact_fuse_time).timeout.connect(_detonate)
+
+
+func _detonate() -> void:
+	if _has_detonated:
+		return
+	_has_detonated = true
+
+	var explosion := EXPLOSION_SCENE.instantiate()
+	get_parent().add_child(explosion)
+	explosion.global_position = global_position
+
+	_apply_explosion_damage()
+	queue_free()
+
+
+func _apply_explosion_damage() -> void:
+	for target in get_tree().get_nodes_in_group("damageables"):
+		if target == thrower or not is_instance_valid(target) or not target.has_method("damage"):
+			continue
+		var target_node := target as Node3D
+		if target_node == null:
+			continue
+		var offset := global_position - target_node.global_position
+		var distance: float = offset.length()
+		if distance > explosion_radius:
+			continue
+		var away_from_explosion := -offset.normalized()
+		if distance < 0.001:
+			away_from_explosion = Vector3.UP
+		var falloff: float = 1.0 - clamp(distance / explosion_radius, 0.0, 1.0)
+		var strength: float = explosion_force * max(falloff, 0.35)
+		var force: Vector3 = (away_from_explosion + Vector3.UP * 0.35).normalized() * strength
+		target.damage(offset, force)
