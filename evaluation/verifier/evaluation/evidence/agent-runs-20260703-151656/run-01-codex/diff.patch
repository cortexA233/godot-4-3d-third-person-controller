+class_name GrenadeThrowProfile
+extends RefCounted
+
+const GRAVITY := 18.0
+const DEFAULT_RANGE := 9.0
+const DEFAULT_UP_SPEED := 7.5
+const MIN_AIM_RANGE := 5.0
+const MAX_AIM_RANGE := 16.0
+const MIN_FLIGHT_TIME := 0.65
+const MAX_FLIGHT_TIME := 1.4
+
+
+static func default_launch_velocity(forward: Vector3) -> Vector3:
+	var horizontal_direction := _safe_horizontal_direction(forward, Vector3.BACK)
+	var flight_time: float = 2.0 * DEFAULT_UP_SPEED / GRAVITY
+	var horizontal_speed: float = DEFAULT_RANGE / flight_time
+	return horizontal_direction * horizontal_speed + Vector3.UP * DEFAULT_UP_SPEED
+
+
+static func aimed_launch_velocity(origin: Vector3, target: Vector3, fallback_forward: Vector3) -> Vector3:
+	var offset := target - origin
+	var horizontal_offset := Vector3(offset.x, 0.0, offset.z)
+	var horizontal_direction := _safe_horizontal_direction(horizontal_offset, fallback_forward)
+	var horizontal_range: float = clamp(horizontal_offset.length(), MIN_AIM_RANGE, MAX_AIM_RANGE)
+	var flight_time: float = clamp(horizontal_range / 10.0, MIN_FLIGHT_TIME, MAX_FLIGHT_TIME)
+	var horizontal_speed: float = horizontal_range / flight_time
+	var vertical_speed: float = (offset.y + 0.5 * GRAVITY * flight_time * flight_time) / flight_time
+	return horizontal_direction * horizontal_speed + Vector3.UP * vertical_speed
+
+
+static func predict_flat_ground_landing(origin: Vector3, launch_velocity: Vector3, ground_y: float = 0.0) -> Vector3:
+	var height: float = origin.y - ground_y
+	var discriminant: float = launch_velocity.y * launch_velocity.y + 2.0 * GRAVITY * height
+	var flight_time: float = (launch_velocity.y + sqrt(max(discriminant, 0.0))) / GRAVITY
+	return origin + Vector3(launch_velocity.x, 0.0, launch_velocity.z) * flight_time + Vector3.UP * (ground_y - origin.y)
+
+
+static func sample_trajectory(origin: Vector3, launch_velocity: Vector3, steps: int, interval: float) -> PackedVector3Array:
+	var points := PackedVector3Array()
+	for index in range(steps):
+		var time: float = float(index) * interval
+		points.append(origin + launch_velocity * time + Vector3.DOWN * (0.5 * GRAVITY * time * time))
+	return points
+
+
+static func _safe_horizontal_direction(direction: Vector3, fallback: Vector3) -> Vector3:
+	var horizontal_direction := Vector3(direction.x, 0.0, direction.z)
+	if horizontal_direction.length() < 0.001:
+		horizontal_direction = Vector3(fallback.x, 0.0, fallback.z)
+	if horizontal_direction.length() < 0.001:
+		return Vector3.BACK
+	return horizontal_direction.normalized()
