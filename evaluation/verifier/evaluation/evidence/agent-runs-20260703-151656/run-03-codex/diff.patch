diff --git a/tests/test_grenade_math.gd b/tests/test_grenade_math.gd
new file mode 100644
index 0000000..1836ce1
--- /dev/null
+++ b/tests/test_grenade_math.gd
@@ -0,0 +1,59 @@
+extends Node
+
+const GrenadeMathScript := preload("res://player/grenade_math.gd")
+
+var _failures: Array[String] = []
+
+
+func _ready() -> void:
+	_test_launch_velocity_lands_on_target()
+	_test_sampled_arc_rises_before_landing()
+	_test_radius_check_uses_spatial_distance()
+
+	if _failures.is_empty():
+		print("GRENADE_MATH_TESTS: PASS")
+	else:
+		for failure in _failures:
+			push_error(failure)
+		print("GRENADE_MATH_TESTS: FAIL ", _failures.size())
+
+
+func _test_launch_velocity_lands_on_target() -> void:
+	var origin := Vector3(0.0, 1.0, 0.0)
+	var target := Vector3(0.0, 1.0, -8.0)
+	var velocity: Vector3 = GrenadeMathScript.launch_velocity(origin, target, 16.0, 1.0)
+	var samples: PackedVector3Array = GrenadeMathScript.sample_arc(origin, velocity, 16.0, 1.0, 12)
+	var landing := samples[samples.size() - 1]
+
+	_assert_vector_approx(landing, target, "launch_velocity should land the arc on the requested target")
+
+
+func _test_sampled_arc_rises_before_landing() -> void:
+	var origin := Vector3.ZERO
+	var target := Vector3(0.0, 0.0, -8.0)
+	var velocity: Vector3 = GrenadeMathScript.launch_velocity(origin, target, 16.0, 1.2)
+	var samples: PackedVector3Array = GrenadeMathScript.sample_arc(origin, velocity, 16.0, 1.2, 12)
+	var highest_y := -INF
+
+	for point in samples:
+		highest_y = max(highest_y, point.y)
+
+	_assert_true(highest_y > origin.y + 1.0, "sample_arc should produce a visible upward arc")
+	_assert_vector_approx(samples[samples.size() - 1], target, "sample_arc should end at the ballistic target")
+
+
+func _test_radius_check_uses_spatial_distance() -> void:
+	var origin := Vector3.ZERO
+
+	_assert_true(GrenadeMathScript.is_within_radius(origin, Vector3(2.0, 0.0, 1.0), 3.0), "targets inside radius should be affected")
+	_assert_true(not GrenadeMathScript.is_within_radius(origin, Vector3(4.0, 0.0, 0.0), 3.0), "targets outside radius should not be affected")
+
+
+func _assert_true(value: bool, message: String) -> void:
+	if not value:
+		_failures.append(message)
+
+
+func _assert_vector_approx(actual: Vector3, expected: Vector3, message: String) -> void:
+	if actual.distance_to(expected) > 0.01:
+		_failures.append("%s: expected %s, got %s" % [message, expected, actual])
