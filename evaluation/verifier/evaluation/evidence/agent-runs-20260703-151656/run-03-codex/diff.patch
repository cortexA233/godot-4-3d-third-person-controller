+	var flight_time := grenade_aim_flight_time if is_aiming else grenade_default_flight_time
+	var launch_velocity: Vector3 = GrenadeMath.launch_velocity(origin, target, grenade_gravity, flight_time)
+
+	return {
+		"origin": origin,
+		"target": target,
+		"velocity": launch_velocity,
+		"flight_time": flight_time,
+	}
+
+
+func _get_grenade_origin() -> Vector3:
+	var forward := _get_flat_forward_direction()
+	return global_position + Vector3.UP * grenade_spawn_height + forward * grenade_spawn_forward_offset
+
+
+func _get_grenade_target(origin: Vector3, is_aiming: bool) -> Vector3:
+	var direction := _get_flat_forward_direction()
+	var distance := grenade_default_range
+	var target_height := global_position.y + 0.15
+
+	if is_aiming:
+		var aim_target: Vector3 = _camera_controller.get_aim_target()
+		var aim_offset := aim_target - origin
+		var horizontal_offset := Vector3(aim_offset.x, 0.0, aim_offset.z)
+		if horizontal_offset.length_squared() > 0.001:
+			direction = horizontal_offset.normalized()
+			distance = clampf(horizontal_offset.length(), grenade_min_aim_range, grenade_max_aim_range)
+		target_height = clampf(aim_target.y, global_position.y - 1.5, global_position.y + 5.0)
+
+	return Vector3(origin.x, target_height, origin.z) + direction * distance
+
+
+func _get_flat_forward_direction() -> Vector3:
+	var direction := _last_strong_direction
+	direction.y = 0.0
+	if direction.length_squared() < 0.001:
+		direction = Vector3.FORWARD
+	return direction.normalized()
+
