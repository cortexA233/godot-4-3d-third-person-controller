+extends Node3D
+
+@export var bead_count := 18
+@export var bead_radius := 0.075
+@export var target_radius := 0.85
+
+var _beads: Array[MeshInstance3D] = []
+var _target_marker: MeshInstance3D
+var _path_material: StandardMaterial3D
+var _target_material: StandardMaterial3D
+
+
+func _ready() -> void:
+	top_level = true
+	global_transform = Transform3D.IDENTITY
+	_create_materials()
+	_create_beads()
+	_create_target_marker()
+	visible = false
+
+
+func update_trajectory(
+	origin: Vector3,
+	velocity: Vector3,
+	gravity: float,
+	total_time: float,
+	collision_mask: int,
+	excluded_rids: Array,
+	is_throw_ready: bool
+) -> void:
+	var sampled_points := GrenadeMath.sample_arc(origin, velocity, gravity, total_time, bead_count - 1)
+	var preview_points := _clip_points_to_world(sampled_points, collision_mask, excluded_rids)
+
+	_set_ready_state(is_throw_ready)
+
+	for index in range(_beads.size()):
+		var bead := _beads[index]
+		bead.visible = index < preview_points.size()
+		if bead.visible:
+			bead.global_position = preview_points[index]
+
+	_target_marker.visible = not preview_points.is_empty()
+	if _target_marker.visible:
+		_target_marker.global_position = preview_points[preview_points.size() - 1] + Vector3.UP * 0.035
+
+
+func _clip_points_to_world(points: PackedVector3Array, collision_mask: int, excluded_rids: Array) -> PackedVector3Array:
+	if points.is_empty() or not is_inside_tree():
+		return points
+
+	var clipped_points := PackedVector3Array()
+	var space_state := get_world_3d().direct_space_state
+	clipped_points.append(points[0])
+
+	for index in range(1, points.size()):
+		var from := points[index - 1]
+		var to := points[index]
+		var query := PhysicsRayQueryParameters3D.create(from, to)
+		query.collision_mask = collision_mask
+		query.exclude = excluded_rids
+		query.collide_with_areas = false
+		query.collide_with_bodies = true
+
+		var hit := space_state.intersect_ray(query)
+		if hit:
+			clipped_points.append(hit["position"])
+			break
+
+		clipped_points.append(to)
+
+	return clipped_points
+
+
+func _create_materials() -> void:
+	_path_material = StandardMaterial3D.new()
+	_path_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	_path_material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
+	_path_material.emission_enabled = true
+
+	_target_material = StandardMaterial3D.new()
+	_target_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	_target_material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
+	_target_material.emission_enabled = true
+
+
+func _create_beads() -> void:
+	var bead_mesh := SphereMesh.new()
+	bead_mesh.radius = bead_radius
+	bead_mesh.height = bead_radius * 2.0
+	bead_mesh.radial_segments = 12
+	bead_mesh.rings = 6
+
+	for index in range(bead_count):
+		var bead := MeshInstance3D.new()
+		bead.name = "ArcBead%d" % index
+		bead.mesh = bead_mesh
+		bead.material_override = _path_material
+		bead.visible = false
+		add_child(bead)
+		_beads.append(bead)
+
+
+func _create_target_marker() -> void:
+	var marker_mesh := CylinderMesh.new()
+	marker_mesh.top_radius = target_radius
+	marker_mesh.bottom_radius = target_radius
+	marker_mesh.height = 0.035
+	marker_mesh.radial_segments = 48
+
+	_target_marker = MeshInstance3D.new()
+	_target_marker.name = "LandingMarker"
+	_target_marker.mesh = marker_mesh
+	_target_marker.material_override = _target_material
+	_target_marker.visible = false
+	add_child(_target_marker)
+
+
+func _set_ready_state(is_throw_ready: bool) -> void:
+	var color := Color(0.0, 0.72, 1.0, 0.95) if is_throw_ready else Color(1.0, 0.64, 0.12, 0.52)
+	var marker_color := color
+	marker_color.a *= 0.45
+
+	_path_material.albedo_color = color
+	_path_material.emission = Color(color.r, color.g, color.b)
+	_path_material.emission_energy_multiplier = 1.25 if is_throw_ready else 0.75
+	_target_material.albedo_color = marker_color
+	_target_material.emission = Color(marker_color.r, marker_color.g, marker_color.b)
+	_target_material.emission_energy_multiplier = 0.8 if is_throw_ready else 0.5
