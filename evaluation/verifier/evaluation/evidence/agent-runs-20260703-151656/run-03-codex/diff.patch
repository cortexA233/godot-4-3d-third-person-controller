diff --git a/tests/test_grenade_projectile.gd b/tests/test_grenade_projectile.gd
new file mode 100644
index 0000000..72bb730
--- /dev/null
+++ b/tests/test_grenade_projectile.gd
@@ -0,0 +1,71 @@
+extends Node3D
+
+const GrenadeScene := preload("res://player/grenade_projectile.tscn")
+
+var _failures: Array[String] = []
+
+
+class DummyDamageable:
+	extends Node3D
+
+	var damage_calls := 0
+	var last_force := Vector3.ZERO
+
+	func _init(node_name: String, start_position: Vector3) -> void:
+		name = node_name
+		position = start_position
+		add_to_group("damageables")
+
+	func damage(_impact_point: Vector3, force: Vector3) -> void:
+		damage_calls += 1
+		last_force = force
+
+
+func _ready() -> void:
+	await get_tree().process_frame
+	_test_explosion_damage_is_spatial_and_ignores_player()
+
+	if _failures.is_empty():
+		print("GRENADE_PROJECTILE_TESTS: PASS")
+	else:
+		for failure in _failures:
+			push_error(failure)
+		print("GRENADE_PROJECTILE_TESTS: FAIL ", _failures.size())
+
+
+func _test_explosion_damage_is_spatial_and_ignores_player() -> void:
+	var grenade = GrenadeScene.instantiate()
+	add_child(grenade)
+	grenade.global_position = Vector3.ZERO
+
+	var near_target := DummyDamageable.new("NearTarget", Vector3(2.0, 0.0, 0.0))
+	var far_target := DummyDamageable.new("FarTarget", Vector3(8.0, 0.0, 0.0))
+	var player_target := PlayerLikeDamageable.new("Player", Vector3(1.0, 0.0, 0.0))
+	add_child(near_target)
+	add_child(far_target)
+	add_child(player_target)
+
+	grenade.detonate()
+	await get_tree().process_frame
+
+	_assert_equal(near_target.damage_calls, 1, "near damageable should be damaged once")
+	_assert_true(near_target.last_force.length() > 0.0, "near damageable should receive a visible force")
+	_assert_equal(far_target.damage_calls, 0, "distant damageable should not be damaged")
+	_assert_equal(player_target.damage_calls, 0, "player should not be damaged by grenade explosion")
+
+
+func _assert_true(value: bool, message: String) -> void:
+	if not value:
+		_failures.append(message)
+
+
+func _assert_equal(actual: int, expected: int, message: String) -> void:
+	if actual != expected:
+		_failures.append("%s: expected %d, got %d" % [message, expected, actual])
+
+
+class PlayerLikeDamageable:
+	extends DummyDamageable
+
+	func lose_coins() -> void:
+		pass
