@@ -0,0 +1,85 @@
+extends RigidBody3D
+
+const EXPLOSION_SCENE_PATH := "res://player/explosion_visuals/explosion_scene.tscn"
+
+@export var explosion_radius := 3.6
+@export var explosion_force := 13.0
+@export var fuse_time := 1.75
+@export var impact_detonation_delay := 0.35
+
+var shooter: Node3D = null
+
+var _detonated := false
+var _impact_timer_started := false
+
+@onready var _fuse_timer: Timer = $FuseTimer
+@onready var _impact_timer: Timer = $ImpactTimer
+@onready var _visual_root: Node3D = $GrenadeVisual
+
+
+func _ready() -> void:
+	body_entered.connect(_on_body_entered)
+	_fuse_timer.wait_time = fuse_time
+	_fuse_timer.timeout.connect(detonate)
+	_fuse_timer.start()
+	_impact_timer.wait_time = impact_detonation_delay
+	_impact_timer.timeout.connect(detonate)
+
+
+func throw(initial_velocity: Vector3, thrower: Node3D) -> void:
+	shooter = thrower
+	linear_velocity = initial_velocity
+	angular_velocity = Vector3(initial_velocity.z, 0.0, -initial_velocity.x).limit_length(14.0)
+	if shooter is PhysicsBody3D:
+		add_collision_exception_with(shooter)
+
+
+func _physics_process(delta: float) -> void:
+	if linear_velocity.length_squared() > 0.01:
+		_visual_root.rotate_object_local(Vector3.RIGHT, linear_velocity.length() * delta)
+
+
+func detonate() -> void:
+	if _detonated:
+		return
+
+	_detonated = true
+	_spawn_explosion()
+	_apply_explosion_damage()
+	queue_free()
+
+
+func _spawn_explosion() -> void:
+	var explosion = load(EXPLOSION_SCENE_PATH).instantiate()
+	get_parent().add_child(explosion)
+	explosion.global_position = global_position
+
+
+func _apply_explosion_damage() -> void:
+	for body in get_tree().get_nodes_in_group("damageables"):
+		if not is_instance_valid(body) or body == shooter or body.has_method("lose_coins"):
+			continue
+		if not body is Node3D or not body.has_method("damage"):
+			continue
+
+		var target := body as Node3D
+		if not GrenadeMath.is_within_radius(global_position, target.global_position, explosion_radius):
+			continue
+
+		var offset := target.global_position - global_position
+		var distance := maxf(offset.length(), 0.1)
+		var falloff := 1.0 - clampf(distance / explosion_radius, 0.0, 1.0)
+		var force_direction := offset.normalized() if offset.length_squared() > 0.001 else Vector3.UP
+		var force := force_direction * explosion_force * (0.45 + falloff * 0.55)
+		force += Vector3.UP * explosion_force * 0.35
+
+		var impact_point := global_position - target.global_position
+		body.damage(impact_point, force)
+
+
+func _on_body_entered(body: Node3D) -> void:
+	if body == shooter or _impact_timer_started:
+		return
+
+	_impact_timer_started = true
+	_impact_timer.start()
