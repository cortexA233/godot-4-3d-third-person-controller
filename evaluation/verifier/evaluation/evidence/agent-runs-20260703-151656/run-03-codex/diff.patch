@@ -0,0 +1,26 @@
+class_name GrenadeMath
+extends RefCounted
+
+
+static func launch_velocity(origin: Vector3, target: Vector3, gravity: float, flight_time: float) -> Vector3:
+	var safe_time := maxf(flight_time, 0.001)
+	var displacement := target - origin
+	var horizontal_velocity := Vector3(displacement.x, 0.0, displacement.z) / safe_time
+	var vertical_velocity := (displacement.y + 0.5 * gravity * safe_time * safe_time) / safe_time
+
+	return horizontal_velocity + Vector3.UP * vertical_velocity
+
+
+static func sample_arc(origin: Vector3, velocity: Vector3, gravity: float, total_time: float, step_count: int) -> PackedVector3Array:
+	var safe_steps := maxi(step_count, 1)
+	var points := PackedVector3Array()
+
+	for index in range(safe_steps + 1):
+		var t := total_time * float(index) / float(safe_steps)
+		points.append(origin + velocity * t + Vector3.DOWN * (0.5 * gravity * t * t))
+
+	return points
+
+
+static func is_within_radius(origin: Vector3, target: Vector3, radius: float) -> bool:
+	return origin.distance_squared_to(target) <= radius * radius
