+class_name GrenadeThrowMath
+extends RefCounted
+
+
+static func get_default_target(origin: Vector3, forward: Vector3, ground_y: float, distance: float) -> Vector3:
+	var horizontal_forward := Vector3(forward.x, 0.0, forward.z)
+	if horizontal_forward.length_squared() < 0.0001:
+		horizontal_forward = Vector3.FORWARD
+	horizontal_forward = horizontal_forward.normalized()
+	return Vector3(origin.x, ground_y, origin.z) + horizontal_forward * distance
+
+
+static func get_throw_velocity(origin: Vector3, target: Vector3, arc_height: float, gravity: float) -> Vector3:
+	var gravity_strength: float = max(abs(gravity), 0.001)
+	var apex_y: float = max(origin.y, target.y) + max(arc_height, 0.001)
+	var time_up: float = sqrt(2.0 * max(apex_y - origin.y, 0.001) / gravity_strength)
+	var time_down: float = sqrt(2.0 * max(apex_y - target.y, 0.001) / gravity_strength)
+	var flight_time: float = max(time_up + time_down, 0.001)
+	var horizontal_delta := Vector3(target.x - origin.x, 0.0, target.z - origin.z)
+
+	return horizontal_delta / flight_time + Vector3.UP * gravity_strength * time_up
+
+
+static func sample_arc_to_ground(origin: Vector3, velocity: Vector3, gravity: float, ground_y: float, step_time: float, max_time: float) -> Array[Vector3]:
+	var samples: Array[Vector3] = [origin]
+	var gravity_strength: float = max(abs(gravity), 0.001)
+	var time: float = max(step_time, 0.01)
+	var previous := origin
+
+	while time <= max_time:
+		var position := origin + velocity * time + Vector3.DOWN * 0.5 * gravity_strength * time * time
+		if position.y <= ground_y:
+			var segment := position - previous
+			var t := 0.0
+			if abs(segment.y) > 0.0001:
+				t = clamp((ground_y - previous.y) / segment.y, 0.0, 1.0)
+			samples.append(previous.lerp(position, t))
+			return samples
+
+		samples.append(position)
+		previous = position
+		time += max(step_time, 0.01)
+
+	return samples
