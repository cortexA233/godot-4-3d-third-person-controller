@@ -0,0 +1,95 @@
+extends RigidBody3D
+
+const EXPLOSION_SCENE := preload("res://player/explosion_visuals/explosion_scene.tscn")
+
+@export var fuse_time := 1.6
+@export var impact_detonation_delay := 0.35
+@export var explosion_radius := 3.5
+@export var explosion_force := 12.0
+
+var shooter: Node = null
+
+@onready var _visual_root: Node3D = $GrenadeVisual
+@onready var _collision_shape: CollisionShape3D = $CollisionShape3D
+@onready var _fuse_timer: Timer = $FuseTimer
+@onready var _impact_timer: Timer = $ImpactTimer
+@onready var _explosion_sound: AudioStreamPlayer3D = $ExplosionSound
+
+var _detonated := false
+var _impact_timer_started := false
+
+
+func _ready() -> void:
+	body_entered.connect(_on_body_entered)
+	_fuse_timer.timeout.connect(_detonate)
+	_impact_timer.timeout.connect(_detonate)
+	_fuse_timer.start(fuse_time)
+
+
+func launch(initial_velocity: Vector3, thrower: Node, gravity_strength: float) -> void:
+	shooter = thrower
+	linear_velocity = initial_velocity
+	angular_velocity = Vector3(randf_range(-8.0, 8.0), randf_range(-12.0, 12.0), randf_range(-8.0, 8.0))
+
+	var default_gravity: float = ProjectSettings.get_setting("physics/3d/default_gravity")
+	gravity_scale = gravity_strength / max(default_gravity, 0.001)
+
+	if shooter is PhysicsBody3D:
+		add_collision_exception_with(shooter)
+
+
+func _on_body_entered(body: Node) -> void:
+	if body == shooter or _detonated or _impact_timer_started:
+		return
+
+	_impact_timer_started = true
+	_impact_timer.start(impact_detonation_delay)
+
+
+func _detonate() -> void:
+	if _detonated:
+		return
+
+	_detonated = true
+	freeze = true
+	linear_velocity = Vector3.ZERO
+	angular_velocity = Vector3.ZERO
+	_collision_shape.set_deferred("disabled", true)
+	_visual_root.hide()
+
+	_damage_nearby_targets()
+	_spawn_explosion_feedback()
+
+	_explosion_sound.pitch_scale = randfn(1.0, 0.08)
+	_explosion_sound.play()
+	await _explosion_sound.finished
+	queue_free()
+
+
+func _damage_nearby_targets() -> void:
+	for target in get_tree().get_nodes_in_group("damageables"):
+		if target == shooter or not target is Node3D:
+			continue
+
+		var target_node := target as Node3D
+		if not target_node.has_method("damage"):
+			continue
+
+		var offset := target_node.global_position - global_position
+		var distance := offset.length()
+		if distance > explosion_radius:
+			continue
+
+		var force_direction := offset.normalized()
+		if force_direction.length_squared() < 0.0001:
+			force_direction = Vector3.UP
+		var falloff: float = 1.0 - clamp(distance / explosion_radius, 0.0, 1.0)
+		var force: Vector3 = (force_direction + Vector3.UP * 0.35).normalized() * explosion_force * max(falloff, 0.35)
+		var impact_point := global_position - target_node.global_position
+		target_node.damage(impact_point, force)
+
+
+func _spawn_explosion_feedback() -> void:
+	var explosion := EXPLOSION_SCENE.instantiate()
+	get_parent().add_child(explosion)
+	explosion.global_position = global_position
