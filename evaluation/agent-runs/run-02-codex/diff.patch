diff --git a/tests/grenade_math_test.gd b/tests/grenade_math_test.gd
new file mode 100644
index 0000000..c1b8154
--- /dev/null
+++ b/tests/grenade_math_test.gd
@@ -0,0 +1,102 @@
+extends Node
+
+const MATH_PATH := "res://player/grenade_throw_math.gd"
+
+var _failures: Array[String] = []
+
+
+func _ready() -> void:
+	_test_default_target_uses_medium_forward_range()
+	_test_throw_velocity_lands_near_flat_target()
+	_test_arc_samples_stop_at_ground()
+
+	if _failures.is_empty():
+		print("[grenade_math_test] PASS")
+		await get_tree().create_timer(5.0).timeout
+		get_tree().quit(0)
+	else:
+		for failure in _failures:
+			push_error(failure)
+		await get_tree().create_timer(5.0).timeout
+		get_tree().quit(1)
+
+
+func _test_default_target_uses_medium_forward_range() -> void:
+	var math_script := load(MATH_PATH)
+	_assert_true(math_script != null, "grenade math script should load")
+	if math_script == null:
+		return
+
+	var origin := Vector3(2.0, 1.0, -3.0)
+	var forward := Vector3(0.2, 0.6, -1.0)
+	var target: Vector3 = math_script.get_default_target(origin, forward, 0.0, 8.0)
+	var horizontal_offset := Vector3(target.x - origin.x, 0.0, target.z - origin.z)
+
+	_assert_approx(horizontal_offset.length(), 8.0, 0.01, "default target should be 8 units forward")
+	_assert_approx(target.y, 0.0, 0.01, "default target should land on requested ground height")
+	_assert_true(horizontal_offset.normalized().dot(Vector3(0.2, 0.0, -1.0).normalized()) > 0.99, "default target should ignore vertical aim and keep horizontal direction")
+
+
+func _test_throw_velocity_lands_near_flat_target() -> void:
+	var math_script := load(MATH_PATH)
+	if math_script == null:
+		return
+
+	var origin := Vector3(0.0, 1.2, 0.0)
+	var target := Vector3(0.0, 0.0, -8.0)
+	var gravity := 30.0
+	var velocity: Vector3 = math_script.get_throw_velocity(origin, target, 4.0, gravity)
+	var impact: Dictionary = _simulate_to_ground(origin, velocity, gravity, 0.0)
+
+	_assert_true(velocity.y > 0.0, "throw should start upward for an arc")
+	_assert_true(float(impact.max_y) > 4.0, "arc should visibly rise before landing")
+	_assert_approx(Vector3(impact.position).distance_to(target), 0.0, 0.25, "throw should land near target")
+
+
+func _test_arc_samples_stop_at_ground() -> void:
+	var math_script := load(MATH_PATH)
+	if math_script == null:
+		return
+
+	var origin := Vector3(0.0, 1.2, 0.0)
+	var target := Vector3(0.0, 0.0, -8.0)
+	var gravity := 30.0
+	var velocity: Vector3 = math_script.get_throw_velocity(origin, target, 4.0, gravity)
+	var samples: Array[Vector3] = math_script.sample_arc_to_ground(origin, velocity, gravity, 0.0, 0.08, 3.0)
+
+	_assert_true(samples.size() > 4, "trajectory preview should have several samples")
+	_assert_approx(samples[0].distance_to(origin), 0.0, 0.01, "trajectory samples should start at origin")
+	_assert_approx(samples.back().y, 0.0, 0.2, "trajectory samples should stop near ground")
+	_assert_approx(samples.back().distance_to(target), 0.0, 0.45, "trajectory samples should end near target")
+
+
+func _simulate_to_ground(origin: Vector3, velocity: Vector3, gravity: float, ground_y: float) -> Dictionary:
+	var position := origin
+	var max_y := origin.y
+	var previous := position
+	var step := 0.01
+
+	for i in range(600):
+		previous = position
+		position += velocity * step
+		velocity.y -= gravity * step
+		max_y = max(max_y, position.y)
+		if position.y <= ground_y:
+			var segment := position - previous
+			var t := 0.0
+			if abs(segment.y) > 0.0001:
+				t = clamp((ground_y - previous.y) / segment.y, 0.0, 1.0)
+			position = previous.lerp(position, t)
+			break
+
+	return {"position": position, "max_y": max_y}
+
+
+func _assert_true(condition: bool, message: String) -> void:
+	if not condition:
+		_failures.append(message)
+
+
+func _assert_approx(actual: float, expected: float, tolerance: float, message: String) -> void:
+	if abs(actual - expected) > tolerance:
+		_failures.append("%s (expected %.3f, got %.3f)" % [message, expected, actual])
